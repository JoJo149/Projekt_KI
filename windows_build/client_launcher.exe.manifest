<?xml version="1.0" encoding="utf-8"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">

  <!-- Identify this as a Windows application -->
  <assemblyIdentity
    version="1.0.0.0"
    processorArchitecture="*"
    name="Company.Product.App"
    type="win32"
  />

  <!-- Application Compatibility -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Enables Windows 10 compatibility -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
      <!-- Enables Windows 8.1 compatibility -->
      <supportedOS Id="{4f476546-9373-403e-9b67-64c6b7f44ed6}"/>
      <!-- Enables Windows 8 compatibility -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f28f8a7b}"/>
      <!-- Enables Windows 7 compatibility -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
    </application>
  </compatibility>

  <!-- Security: Request administrator privileges -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel
          level="requireAdministrator"
          uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>

</assembly>